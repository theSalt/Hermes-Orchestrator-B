# ===== hermes-dispatch 配置（复制为 .env 后修改；B 方案：Hermes Desktop 多用户接入）=====

# 管理 API 的 Bearer Key（用户管理/运维端点用；务必改掉默认值）
HERMES_ADMIN_KEY=dev-admin-key

# 派生每用户 dispatch token / agent key 的 HMAC 密钥；生产务必改为长随机串
# （openssl rand -hex 32）。注意：更换后所有用户 token 全部改变，需重新下发。
HERMES_SECRET_KEY=change-me-to-a-long-random-string

# 管理后台登录会话有效期（秒）；换 HERMES_ADMIN_KEY 即全体管理会话失效
HERMES_ADMIN_SESSION_TTL_SECONDS=86400

# ===== PostgreSQL（用户注册表）=====

# 镜像可换加速前缀（Docker Hub 直连受限时，如 docker.1ms.run/library/postgres:16-alpine）
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_USER=hermes
# 建议字母数字长随机串（URL 内特殊字符需转义）；改后需同步调整数据库或删卷重建
POSTGRES_PASSWORD=
POSTGRES_DB=hermes
# 默认由上面 POSTGRES_* 组装，留空即可；直跑/特殊部署时可整体覆盖
HERMES_DATABASE_URL=

# 对外公布的 gateway URL 前缀（管理 API 返回给用户粘贴进 desktop）。
# 置空则按请求 Host 反推（直连 117 场景即 http://192.168.0.117:8644）。
# 经 nginx subpath 访问时填 nginx 源站（如 http://192.168.0.117）。
HERMES_PUBLIC_URL=

# 反代 subpath 前缀（如 http://192.168.0.117/hermes/... 访问时填 /hermes）。
# nginx 侧剥掉该前缀转发（见 deploy/nginx-hermes.conf）；dispatch 用它修正
# X-Forwarded-Prefix / 会话 cookie Path / 管理 API 的 gateway_url。
HERMES_PUBLIC_PATH=

# ===== agent 镜像 =====

# overlay 镜像 tag（由 compose 的 agent-image 服务从基线构建，含 dashboard-forwarder）
HERMES_IMAGE=hermes-agent:desktop
# overlay 基线（Docker Hub 直连受限的环境用加速前缀）
HERMES_BASE_IMAGE=docker.1ms.run/nousresearch/hermes-agent:latest

# ===== 管理台前端构建（compose 构建时用）=====

# node 基础镜像 / npm 源（Docker Hub 直连受限时换加速前缀）
NODE_IMAGE=node:22-alpine
NPM_REGISTRY=https://registry.npmmirror.com

# ===== dashboard 附件插件（agent-overlay/dashboard-plugin）=====

# 附件插件前端构建用同一 NODE_IMAGE / NPM_REGISTRY；
# 插件后端（plugin_api.py）跑在 agent 容器内，读容器 env。要覆盖默认值时，
# 加入 HERMES_AGENT_EXTRA_ENV（compose 会注入每个 agent 容器），例如：
# HERMES_AGENT_EXTRA_ENV={"HERMES_PLUGIN_ATTACH_MAX_MB":200,"HERMES_PLUGIN_SOFFICE_TIMEOUT":120}
# 默认：上传上限 200MB（HERMES_PLUGIN_ATTACH_MAX_MB），转换超时 120s
# （HERMES_PLUGIN_SOFFICE_TIMEOUT）。

# ===== 端口/网络 =====

# dispatch 对外端口（A 方案 orchestrator 占 8643，这里错开）
HERMES_PORT=8644
HERMES_AGENT_PORT=8642
HERMES_DASHBOARD_PORT=9119
HERMES_DASH_FWD_PORT=9120
# agent 容器所在 docker 网络（与 A 方案的 hermes-net / owu_default 隔离）
HERMES_NETWORK=hermes-b-net

# ===== 资源与生命周期 =====

HERMES_CPU_LIMIT=2
HERMES_MEM_LIMIT=2g
# 空闲回收（分钟，0=不回收）；有活跃 WS 连接的用户不回收
HERMES_IDLE_TIMEOUT_MINUTES=60
HERMES_START_TIMEOUT_SECONDS=240
HERMES_SWEEP_INTERVAL_SECONDS=30
# 代理请求冷启动等待上限（秒），超时 503，desktop 会重试
HERMES_PROXY_START_WAIT_SECONDS=90
HERMES_PROXY_TIMEOUT_SECONDS=600
HERMES_WS_MAX_SIZE_MB=128

# ===== 存储 =====

# 用户数据根目录（HERMES_HOME 卷）。同一路径双视角挂载，保持两者一致即可
HERMES_DATA_DIR=/data/DockerVolume/hermes-b
HERMES_DATA_HOST_DIR=/data/DockerVolume/hermes-b

# ===== agent 容器 =====

# 直连 /v1/chat/completions（无用户头冒烟）时的兜底用户
HERMES_DEFAULT_USER=default
# 额外注入 agent 容器的环境变量（JSON）——例如给 Hermes 配模型 Key：
# HERMES_AGENT_EXTRA_ENV={"OPENAI_API_KEY":"sk-...","OPENAI_BASE_URL":"https://api.z.ai/api/coding/paas/v4"}
HERMES_AGENT_EXTRA_ENV={}
# agent 容器内 uv/pip 的 PyPI 镜像（hermes 首启 lazy-install 依赖用；也作为 overlay
# 构建 agent-image 时的 PYPI_INDEX 默认值）
HERMES_PYPI_MIRROR=https://pypi.tuna.tsinghua.edu.cn/simple
# overlay 构建 agent-image 时的 Debian apt 源（传空串回官方源）
APT_MIRROR=mirrors.tuna.tsinghua.edu.cn

# 模型配置种子：首启时写入该用户 config.yaml 的 model 块（hermes 的模型唯一配置入口）。
# OPENAI_API_KEY/OPENAI_BASE_URL 走上面的 EXTRA_ENV；模型名置空则不种子化。
HERMES_MODEL_PROVIDER=openai-api
HERMES_MODEL_NAME=glm-4.6
# 自定义 OpenAI 兼容端点时需要（如 z.ai coding 端点）；api_mode 固定 chat_completions
HERMES_MODEL_BASE_URL=https://api.z.ai/api/coding/paas/v4
HERMES_MODEL_API_MODE=chat_completions

# /v1 附件上限（MB）
HERMES_MAX_FILE_MB=50
